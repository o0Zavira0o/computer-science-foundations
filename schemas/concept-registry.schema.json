{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CSF Concept Registry",
  "type": "object",
  "required": ["schema_version", "track", "concepts"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "track": {"type": "string"},
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "aliases", "current_depth"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "current_depth": {"type": ["string", "null"], "enum": [null, "D0", "D1", "D2", "D3", "D4", "D5"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
