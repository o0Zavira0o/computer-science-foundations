{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CSF Example Registry",
  "type": "object",
  "required": ["schema_version", "track", "examples"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "track": {"type": "string"},
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "signature", "domain", "first_lesson"],
        "properties": {
          "id": {"type": "string"},
          "signature": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "first_lesson": {"type": ["string", "null"]},
          "reuse_purpose": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
